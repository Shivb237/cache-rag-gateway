{
  "name": "cache-rag-gateway",
  "version": "0.1.0",
  "description": "A gateway in front of a RAG pipeline with layered caches, plus an eval harness that measures every layer.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "subset": "tsx scripts/build-subset.ts",
    "index": "tsx scripts/build-index.ts",
    "eval": "tsx eval/run.ts",
    "watch": "tsx scripts/watch-run.ts",
    "ablation": "tsx eval/ablation.ts",
    "staleness": "tsx eval/staleness.ts",
    "serve": "tsx src/serve.ts",
    "replay": "tsx scripts/export-replay.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@huggingface/transformers": "4.3.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
