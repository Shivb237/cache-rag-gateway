# Copy to .env (it is gitignored). The default setup needs no key: the LLM runs locally in Ollama and embeddings run locally.
OLLAMA_HOST=http://127.0.0.1:11434

# Only for Claude runs (add --override configs/providers/claude_sonnet.yaml). Paid: the config carries a hard spend cap.
# ANTHROPIC_API_KEY=

# Only for the HTTP service (npm run serve). When set, /ask and /stats require this value in an x-api-key header.
# GATEWAY_API_KEY=
# Optional: lower spend cap in USD for the service, and the port it listens on (default 8080).
# SPEND_CAP_USD=1
# PORT=8080
